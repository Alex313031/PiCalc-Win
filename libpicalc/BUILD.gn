import("//build/config/precompiled_header.gni")

# Ensure precompiled headers work
precompiled_header("precompiled") {
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cc"
}

config("libgmp_prebuilt") {
  libs = []
  ldflags = [ "/ignore:4099" ]
  if (current_cpu == "x86") {
    if (is_debug) {
      libs = [
        "//src/picalc_win/libpicalc/gmp/x86/debug/gmp.lib",
        "//src/picalc_win/libpicalc/gmp/x86/debug/gmpxx.lib",
      ]
    } else {
      libs = [
        "//src/picalc_win/libpicalc/gmp/x86/release/gmp.lib",
        "//src/picalc_win/libpicalc/gmp/x86/release/gmpxx.lib",
      ]
    }
  } else if (current_cpu == "x64") {
    if (is_debug) {
      libs = [
        "//src/picalc_win/libpicalc/gmp/x64/debug/gmp.lib",
        "//src/picalc_win/libpicalc/gmp/x64/debug/gmpxx.lib",
      ]
    } else {
      libs = [
        "//src/picalc_win/libpicalc/gmp/x64/release/gmp.lib",
        "//src/picalc_win/libpicalc/gmp/x64/release/gmpxx.lib",
      ]
    }
  } else {
    assert(current_cpu != "arm64", "GMP only supported on x86 and x64!")
  }
}

# All of our Pi functions in one nice .dll
shared_library("libpicalc") {
  defines = [ "INSIDE_DLL" ]
  configs -= [ "//build/config/win:nominmax", ]
  configs += [ ":libpicalc_config" ]

  sources = [
    "compiler_specific.h",
    "component_export.h",
    "constants.h",
    "libpicalc.cc",
    "libpicalc.h",
    "libpicalc_dll.h",
    "libpicalc.rc",
    "stdafx.h"
  ]
  #deps = [ ":libpicalc_sources" ]

  public_deps = [ "//src/picalc_win/libpicalc/gmp:gmp_headers" ]
  public_deps += [
    "//src/picalc_win/libpicalc/gmp:gmp",
    "//src/picalc_win/libpicalc/gmp:gmpxx"
  ]
}

# For no dependencies
static_library("libpicalc_static") {
  configs -= [ "//build/config/win:nominmax", ]
  configs += [ ":libpicalc_config" ]

  sources = [
    "compiler_specific.h",
    "component_export.h",
    "constants.h",
    "libpicalc.cc",
    "libpicalc.h",
    "libpicalc_dll.h",
    "libpicalc.rc",
    "stdafx.h"
  ]
  #deps = [ ":libpicalc_sources" ]

  public_deps = [ "//src/picalc_win/libpicalc/gmp:gmp_headers" ]
  public_deps += [
    "//src/picalc_win/libpicalc/gmp:gmp",
    "//src/picalc_win/libpicalc/gmp:gmpxx"
  ]
}

source_set("libpicalc_sources") {
  configs += [ ":libpicalc_config" ]

  sources = [
    "compiler_specific.h",
    "component_export.h",
    "constants.h",
    "libpicalc.cc",
    "libpicalc.h",
    "libpicalc_dll.h",
    "libpicalc.rc"
  ]
}

config("libpicalc_config") {
  configs = []
  # Must explicitly set this for sources
  configs += [ "//build/config/win:windowed", ]

  configs += [
    ":libpicalc_nt5",
    ":precompiled",
    #":libgmp_prebuilt"
    #":libgmp"
  ]
}

config("libpicalc_nt5") {
  libs = [
    "iphlpapi.lib",
    "powrprof.lib",
    "wtsapi32.lib"
  ]
}
