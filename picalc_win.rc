/////////////////////////////////////////////////////////////////////////////
//
// Version Information
//

// Main version constant
#ifndef _VERSION
// Run stringizer
#define _VERSION(major,minor,build) STRINGIZE(major) "." STRINGIZE(minor) "." STRINGIZE(build)
#endif

// Convert to string to use later
#ifndef VERSION_STRING
#define VERSION_STRING _VERSION(MAJOR_VERSION, MINOR_VERSION, BUILD_VERSION)
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MAJOR_VERSION, MINOR_VERSION, BUILD_VERSION
 PRODUCTVERSION MAJOR_VERSION, MINOR_VERSION, BUILD_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG // 0x1L
#else
 FILEFLAGS 0x0L // Normal?
#endif
 // Windows NT
 FILEOS VOS_NT_WINDOWS32 // 0x40004L
 FILETYPE VFT_APP // 0x1L
 FILESUBTYPE VFT2_UNKNOWN // 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // Neutral Language Character Set
        BEGIN
            VALUE "Comments", "https://github.com/Alex313031/PiCalc-Win"
            VALUE "CompanyName", "Alex313031"
            VALUE "FileDescription", "Threaded GUI Pi Calculator for Windows"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "picalc_win"
            VALUE "LegalCopyright", LEGAL_COPYRIGHT
            VALUE "LegalTrademarks", "https://github.com/Alex313031/PiCalc-Win/blob/main/LICENSE.md"
            VALUE "OriginalFilename", "picalc.exe"
            VALUE "ProductName", "PiCalc-Win"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDR_MAINFRAME    ICON         "icon.ico"
IDI_PICALC       ICON         "icon.ico"
IDI_SMALL        ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINMENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",         ID_FILE_NEW
        MENUITEM "&Open...",     ID_FILE_OPEN
        MENUITEM "&Save &As...", ID_FILE_SAVEAS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Close",       ID_FILE_CLOSE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Exit",        IDM_EXIT
    END
    POPUP "&Edit",               GRAYED
    BEGIN
        MENUITEM "&Cut",         ID_EDIT_CUT
        MENUITEM "&Copy",        ID_EDIT_COPY
        MENUITEM "&Paste",       ID_EDIT_PASTE
    END
    POPUP "&Window",             GRAYED
    BEGIN
        MENUITEM "&Tile",        ID_WINDOW_TILE
        MENUITEM "&Cascade",     ID_WINDOW_CASCADE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help",        IDM_HELP,
        MENUITEM "&About",       IDM_ABOUT,
    END
    POPUP "&?"                   HELP
    BEGIN
        MENUITEM "&Help",        IDM_HELP,
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
   // Window Class
   IDC_PICALC            "PICALC_WINCLASS"
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 0, 0, 147, 67
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PiCalc-Win"
CHARACTERISTICS 17062
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_PICALC, IDC_STATIC, 7, 7, 20, 20, SS_ICON
    LTEXT           ABOUT_VERSION, IDC_STATIC, 34, 7, 98, 8
    LTEXT           ABOUT_COPYRIGHT, IDC_STATIC, 34, 17, 86, 8
    DEFPUSHBUTTON   "OK", IDOK, 90, 46, 50, 14, WS_GROUP
END

/////////////////////////////////////////////////////////////////////////////
//
// Keyboard Accelerators
//

IDR_MAINMENU ACCELERATORS
BEGIN
    "/",  IDM_ABOUT, ASCII, ALT
    //"?",  IDM_HELP,  VIRTKEY, ALT, NOINVERT
    //"/",  IDM_HELP,  VIRTKEY, CONTROL, NOINVERT
END

